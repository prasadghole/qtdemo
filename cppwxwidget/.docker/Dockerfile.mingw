FROM ubuntu:noble

# Install MinGW cross-compiler and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    mingw-w64 \
    mingw-w64-tools \
    mingw-w64-x86-64-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Download and build wxWidgets for Windows (MinGW)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /wxWidgets && \
    cd /wxWidgets && \
    wget -q https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.5/wxWidgets-3.2.5.tar.bz2 && \
    tar -xjf wxWidgets-3.2.5.tar.bz2 && \
    cd wxWidgets-3.2.5 && \
    mkdir -p build-mingw && \
    cd build-mingw && \
    ../configure \
        --host=x86_64-w64-mingw32 \
        --prefix=/opt/wx-mingw \
        --with-msw \
        --disable-shared \
        --enable-monolithic \
        && \
    make -j$(nproc) && \
    make install && \
    cd /wxWidgets && \
    rm -rf wxWidgets-3.2.5 wxWidgets-3.2.5.tar.bz2

WORKDIR /workspace

ENV wxWidgets_ROOT_DIR=/opt/wx-mingw
ENV CMAKE_BUILD_TYPE=Release

CMD ["make", "windows"]
