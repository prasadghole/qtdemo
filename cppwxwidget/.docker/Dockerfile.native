FROM ubuntu:noble

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    pkg-config \
    wx-common \
    libwxgtk3.2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ENV CMAKE_BUILD_TYPE=Release

CMD ["make", "native"]
