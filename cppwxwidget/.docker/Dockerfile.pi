FROM ubuntu:noble

# Install ARM64 cross-compiler
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create sysroot for ARM64
RUN mkdir -p /opt/pi-sysroot && \
    # Download minimal Pi rootfs (for cross-compilation headers and libs)
    # This is a simplified approach; in production, use proper toolchain
    apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-dev:arm64 \
    libx11-dev:arm64 \
    libxinerama-dev:arm64 \
    libxrandr-dev:arm64 \
    libxcursor-dev:arm64 \
    libxcomposite-dev:arm64 \
    || true && \
    rm -rf /var/lib/apt/lists/*

# Build wxWidgets for ARM64
RUN mkdir -p /wxWidgets && \
    cd /wxWidgets && \
    curl -L -o wxWidgets-3.2.5.tar.bz2 \
        https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.5/wxWidgets-3.2.5.tar.bz2 && \
    tar -xjf wxWidgets-3.2.5.tar.bz2 && \
    cd wxWidgets-3.2.5 && \
    mkdir -p build-arm64 && \
    cd build-arm64 && \
    ../configure \
        --host=aarch64-linux-gnu \
        --prefix=/opt/wx-arm64 \
        --with-gtk=3 \
        --enable-unicode \
        --disable-shared \
        && \
    make -j$(nproc) && \
    make install && \
    cd /wxWidgets && \
    rm -rf wxWidgets-3.2.5 wxWidgets-3.2.5.tar.bz2

COPY pi_toolchain.cmake /workspace/

WORKDIR /workspace

ENV wxWidgets_ROOT_DIR=/opt/wx-arm64
ENV CMAKE_BUILD_TYPE=Debug

CMD ["make", "pi"]
