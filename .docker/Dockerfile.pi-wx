FROM ubuntu:noble
ENV DEBIAN_FRONTEND=noninteractive

# ARM64 cross-compiler and GTK deps for wxWidgets
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    curl \
    pkg-config \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# ARM64 GTK3 headers for wxWidgets configure
RUN dpkg --add-architecture arm64 && \
    echo "\
Types: deb\n\
URIs: http://archive.ubuntu.com/ubuntu/ http://security.ubuntu.com/ubuntu/\n\
Suites: noble noble-updates noble-backports noble-security\n\
Components: main universe restricted multiverse\n\
Architectures: amd64\n\
\n\
Types: deb\n\
URIs: http://ports.ubuntu.com/ubuntu-ports/\n\
Suites: noble noble-updates noble-backports noble-security\n\
Components: main universe restricted multiverse\n\
Architectures: arm64\n\
" > /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-dev:arm64 \
    libx11-dev:arm64 \
    libxinerama-dev:arm64 \
    libxrandr-dev:arm64 \
    libxcursor-dev:arm64 \
    || true && \
    rm -rf /var/lib/apt/lists/*

# Build wxWidgets 3.2.5 for ARM64
RUN mkdir -p /wxWidgets && \
    cd /wxWidgets && \
    curl -L -o wx.tar.bz2 \
        https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.5/wxWidgets-3.2.5.tar.bz2 && \
    tar -xjf wx.tar.bz2 && \
    cd wxWidgets-3.2.5 && \
    mkdir build-arm64 && cd build-arm64 && \
    ../configure \
        --host=aarch64-linux-gnu \
        --prefix=/opt/wx-arm64 \
        --with-gtk=3 \
        --enable-unicode \
        --disable-shared && \
    make -j$(nproc) && make install && \
    cd / && rm -rf /wxWidgets

WORKDIR /workspace

ENV wxWidgets_ROOT_DIR=/opt/wx-arm64

CMD ["make", "pi-wx"]
